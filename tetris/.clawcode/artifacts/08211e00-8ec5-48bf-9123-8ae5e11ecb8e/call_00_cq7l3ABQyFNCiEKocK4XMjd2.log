#### 2.2.3 碰撞检测系统（Collision Detector）
**检测类型**：
1. **边界碰撞**：检查方块是否超出游戏区域边界
2. **方块碰撞**：检查方块是否与已落下方块重叠
3. **底部碰撞**：检查方块是否触底

**算法**：
```typescript
class CollisionDetector {
  // 检测移动是否合法
  checkMove(board: number[][], block: Block, dx: number, dy: number): boolean {
    for (let y = 0; y < block.shape.length; y++) {
      for (let x = 0; x < block.shape[y].length; x++) {
        if (block.shape[y][x]) {
          const newX = block.position.x + x + dx;
          const newY = block.position.y + y + dy;
          
          // 边界检查
          if (newX < 0 || newX >= BOARD_WIDTH || newY >= BOARD_HEIGHT) {
            return false;
          }
          
          // 方块碰撞检查
          if (newY >= 0 && board[newY][newX]) {
            return false;
          }
        }
      }
    }
    return true;
  }
  
  // 检测旋转是否合法
