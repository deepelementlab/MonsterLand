#### 2.2.4 消行和计分系统
**消行算法**：
```typescript
class LineClearer {
  clearLines(board: number[][]): { newBoard: number[][], clearedLines: number } {
    let clearedLines = 0;
    const newBoard: number[][] = [];
    
    for (let y = BOARD_HEIGHT - 1; y >= 0; y--) {
      if (this.isLineFull(board[y])) {
        clearedLines++;
        continue; // 跳过完整行
      }
      newBoard.unshift(board[y]);
    }
    
    // 添加空行到顶部
    while (newBoard.length < BOARD_HEIGHT) {
      newBoard.unshift(new Array(BOARD_WIDTH).fill(0));
    }
    
    return { newBoard, clearedLines };
  }
  
  private isLineFull(line: number[]): boolean {
    return line.every(cell => cell !== 0);
  }
}
```

**计分规则**：
```typescript
class ScoreManager {
  private score: number = 0;
  private level: number = 1;
  private lines: number = 0;
  
  calculateScore(clearedLines: number): void {
    const points = [0, 100, 300, 500, 800]; // 单消、双消、三消、四消
    
    // 基础得分
    this.score += points[clearedLines] * this.level;
    this.lines += clearedLines;
    
    // 等级提升（每10行升一级）
    this.level = Math.floor(this.lines / 10) + 1;
    
    // 奖励分数（连续消行）
    if (clearedLines === 4) {
      this.score += 400; // 消除四行的额外奖励
    }
  }
}
```

#### 2.2.5 用户输入处理
**键盘映射**：
```typescript
class InputHandler {
  private keyMap: Record<string, () => void> = {
    'ArrowLeft': () => this.moveLeft(),
    'ArrowRight': () => this.moveRight(),
    'ArrowDown': () => this.moveDown(),
    'ArrowUp': () => this.rotate(),
    'Space': () => this.hardDrop(),
    'p': () => this.togglePause(),
    'r': () => this.restart()
  };
  
  // 按键重复控制（防止过快移动）
  private lastMoveTime: number = 0;
  private moveDelay: number = 100; // 毫秒
  
  handleKeyDown(event: KeyboardEvent): void {
    const action = this.keyMap[event.key];
    if (action && Date.now() - this.lastMoveTime > this.moveDelay) {
      action();
      this.lastMoveTime = Date.now();
    }
  }
}
```

#### 2.2.6 渲染系统
**Canvas渲染器**：
```typescript
class CanvasRenderer {
  private ctx: CanvasRenderingContext2D;
  private blockSize: number;
  
  render(board: number[][], currentBlock: Block, nextBlock: Block): void {
    // 1. 清除画布
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    
    // 2. 绘制网格背景
    this.drawGrid();
    
    // 3. 绘制已落下方块
    this.drawBoard(board);
    
    // 4. 绘制当前方块
    this.drawBlock(currentBlock);
    
    // 5. 绘制预览（ghost方块）
    this.drawGhostBlock(currentBlock, board);
    
    // 6. 绘制UI（分数、等级、下一个方块）
    this.drawUI(score, level, nextBlock);
  }
  
  private drawBlock(block: Block): void {
    block.shape.forEach((row, y) => {
      row.forEach((cell, x) => {
        if (cell) {
          const screenX = (block.position.x + x) * this.blockSize;
          const screenY = (block.position.y + y) * this.blockSize;
          
          // 绘制方块，带3D效果
          this.draw3DBlock(screenX, screenY, block.color);
        }
      });
    });
  }
}
```

#### 2.2.7 游戏状态管理
**状态机设计**：
```typescript
enum GameState {
  MENU,      // 菜单界面
  PLAYING,   // 游戏中
  PAUSED,    // 暂停
  GAME_OVER, // 游戏结束
  SETTINGS   // 设置界面
}

class GameStateManager {
  private currentState: GameState = GameState.MENU;
  private previousState: GameState | null = null;
  
  transitionTo(newState: GameState): void {
    this.previousState = this.currentState;
    this.currentState = newState;
    
    // 触发状态变化事件
    this.onStateChange.emit({
      from: this.previousState,
      to: this.currentState
    });
  }
  
  togglePause(): void {
    if (this.currentState === GameState.PLAYING) {
      this.transitionTo(GameState.PAUSED);
    } else if (this.currentState === GameState.PAUSED) {
      this.transitionTo(GameState.PLAYING);
    }
  }
}
```

