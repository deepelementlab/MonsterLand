### 3.2 核心类设计

#### 3.2.1 主游戏控制器
```typescript
class TetrisGame {
  // 核心组件
  private engine: GameEngine;
  private board: Board;
  private scoreManager: ScoreManager;
  private inputHandler: InputHandler;
  private renderer: CanvasRenderer;
  private stateManager: GameStateManager;
  
  // 游戏状态
  private currentBlock: Block | null;
  private nextBlock: Block;
  private isGameOver: boolean = false;
  
  constructor(config: GameConfig) {
    this.initializeComponents(config);
    this.setupEventListeners();
  }
  
  start(): void {
    this.engine.start();
    this.stateManager.transitionTo(GameState.PLAYING);
  }
  
  private gameLoop(): void {
    // 1. 处理输入
    this.inputHandler.processInput();
    
    // 2. 更新游戏状态
    this.update();
    
    // 3. 碰撞检测
    this.checkCollisions();
    
    // 4. 渲染
    this.renderer.render(
      this.board.getGrid(),
      this.currentBlock!,
      this.nextBlock,
      this.scoreManager.getScore(),
      this.scoreManager.getLevel()
    );
  }
}
```

#### 3.2.2 方块工厂模式
```typescript
class BlockFactory {
  private static readonly BLOCK_TYPES: BlockType[] = [
    BlockType.I, BlockType.O, BlockType.T,
    BlockType.S, BlockType.Z, BlockType.J, BlockType.L
  ];
  
  // 使用7-bag随机算法（保证公平性）
  private bag: BlockType[] = [];
  
  createRandomBlock(): Block {
    if (this.bag.length === 0) {
      this.refillBag();
    }
    
    const type = this.bag.pop()!;
    return this.createBlock(type);
  }
  
  private refillBag(): void {
    // 复制并打乱
    this.bag = [...BlockFactory.BLOCK_TYPES];
