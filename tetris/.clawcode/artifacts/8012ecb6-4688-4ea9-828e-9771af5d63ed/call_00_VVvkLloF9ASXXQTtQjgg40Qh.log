<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>俄罗斯方块功能测试</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            background: #1a1a2e;
            color: white;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .test-container {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }
        
        header {
            text-align: center;
            padding: 20px;
            background: linear-gradient(135deg, #3b82f6, #06b6d4);
            border-radius: 10px;
            margin-bottom: 20px;
        }
        
        h1 {
            font-size: 36px;
            margin-bottom: 10px;
        }
        
        .test-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .test-card {
            background: rgba(30, 41, 59, 0.9);
            border-radius: 10px;
            padding: 20px;
            border: 2px solid #3b82f6;
        }
        
        .test-card h3 {
            color: #06b6d4;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #3b82f6;
        }
        
        .test-list {
            list-style: none;
        }
        
        .test-item {
            padding: 10px;
            margin-bottom: 8px;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .status {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
        
        .status.passed {
            background: #10b981;
            color: white;
        }
        
        .status.failed {
            background: #ef4444;
            color: white;
        }
        
        .status.pending {
            background: #f59e0b;
            color: white;
        }
        
        .test-button {
            background: #3b82f6;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
        }
        
        .test-button:hover {
            background: #2563eb;
        }
        
        .test-section {
            margin-bottom: 30px;
        }
        
        #testOutput {
            background: rgba(0, 0, 0, 0.3);
            padding: 15px;
            border-radius: 5px;
            font-family: monospace;
            min-height: 200px;
            overflow-y: auto;
            margin-top: 20px;
        }
        
        .game-preview {
            text-align: center;
        }
        
        .game-preview iframe {
            width: 400px;
            height: 600px;
            border: 3px solid #3b82f6;
            border-radius: 10px;
            margin: 20px 0;
        }
        
        .game-link {
            display: inline-block;
            background: #3b82f6;
            color: white;
            padding: 15px 30px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 20px;
            font-weight: bold;
            margin: 20px 0;
            transition: all 0.3s ease;
        }
        
        .game-link:hover {
            background: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);
        }
        
        .instructions {
            background: rgba(30, 41, 59, 0.8);
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            border-left: 4px solid #06b6d4;
        }
        
        .instructions h4 {
            color: #06b6d4;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="test-container">
        <header>
            <h1>俄罗斯方块功能测试</h1>
            <p>游戏功能验证和单元测试</p>
        </header>
        
        <div class="test-card">
            <h3>快速功能验证</h3>
            <div class="instructions">
                <h4>如何测试：</h4>
                <p>1. 点击下方按钮打开完整游戏</p>
                <p>2. 使用键盘控制测试游戏功能</p>
                <p>3. 检查所有功能是否正常工作</p>
            </div>
            
            <a href="index.html" target="_blank" class="game-link">
                ▶ 打开俄罗斯方块游戏
            </a>
            
            <h3>测试项目清单</h3>
            <ul class="test-list">
                <li class="test-item">
                    <span>✅ 游戏界面加载</span>
                    <span class="status pending">待验证</span>
                </li>
                <li class="test-item">
                    <span>✅ 方块生成和显示</span>
                    <span class="status pending">待验证</span>
                </li>
                <li class="test-item">
                    <span>✅ 键盘控制响应</span>
                    <span class="status pending">待验证</span>
                </li>
                <li class="test-item">
                    <span>✅ 方块移动和旋转</span>
                    <span class="status pending">待验证</span>
                </li>
                <li class="test-item">
                    <span>✅ 碰撞检测</span>
                    <span class="status pending">待验证</span>
                </li>
                <li class="test-item">
                    <span>✅ 消行和计分</span>
                    <span class="status pending">待验证</span>
                </li>
                <li class="test-item">
                    <span>✅ 游戏状态管理</span>
                    <span class="status pending">待验证</span>
                </li>
                <li class="test-item">
                    <span>✅ 最高分保存</span>
                    <span class="status pending">待验证</span>
                </li>
            </ul>
        </div>
        
        <div class="test-card">
            <h3>核心功能测试</h3>
            <div id="testOutput">
                点击下方按钮运行JavaScript模块测试...
            </div>
            <button onclick="runModuleTests()" class="test-button">运行模块测试</button>
            <button onclick="clearTestOutput()" class="test-button" style="background: #64748b;">清空输出</button>
        </div>
        
        <div class="test-card">
            <h3>游戏操作说明</h3>
            <div class="instructions">
                <h4>键盘控制：</h4>
                <p>← → : 左右移动方块</p>
                <p>↑ : 旋转方块</p>
                <p>↓ : 加速下落</p>
                <p>空格 : 立即下落（硬降）</p>
                <p>P : 暂停/继续游戏</p>
                <p>R : 重新开始游戏</p>
                <p>Enter : 开始游戏</p>
            </div>
            
            <div class="instructions">
                <h4>测试要点：</h4>
                <p>1. 测试所有方块类型都能正常生成</p>
                <p>2. 测试旋转和移动没有异常</p>
                <p>3. 测试消行计分是否正确</p>
                <p>4. 测试游戏结束条件</p>
                <p>5. 测试重新开始功能</p>
            </div>
        </div>
    </div>
    
    <script type="module">
        // 测试输出元素
        const testOutput = document.getElementById('testOutput');
        
        // 日志函数
        function log(message, type = 'info') {
            const time = new Date().toLocaleTimeString();
            const prefix = type === 'error' ? '❌' : type === 'success' ? '✅' : 'ℹ️';
            testOutput.innerHTML += `<div>[${time}] ${prefix} ${message}</div>`;
            testOutput.scrollTop = testOutput.scrollHeight;
        }
        
        // 清空测试输出
        window.clearTestOutput = function() {
            testOutput.innerHTML = '测试输出已清空...';
        };
        
        // 运行模块测试
        window.runModuleTests = async function() {
            log('开始运行模块测试...');
            
            try {
                // 测试配置文件
                log('测试配置文件加载...');
                const config = await import('./src/config.js');
                if (config.GameConfig && config.BlockType) {
                    log('配置文件加载成功', 'success');
                } else {
                    throw new Error('配置文件不完整');
                }
                
                // 测试方块模块
                log('测试方块模块...');
                const blockModule = await import('./src/block/block.js');
                if (blockModule.Block && blockModule.BlockFactory) {
                    log('方块模块加载成功', 'success');
                    
                    // 测试方块创建
                    const factory = new blockModule.BlockFactory();
                    const block = factory.createNextBlock();
                    log(`方块类型: ${block.type}, 位置: (${block.x}, ${block.y})`, 'success');
                } else {
                    throw new Error('方块模块不完整');
                }
                
                // 测试游戏网格模块
                log('测试游戏网格模块...');
                const gridModule = await import('./src/game/grid.js');
                if (gridModule.GameGrid) {
                    const grid = new gridModule.GameGrid();
                    log(`游戏网格: ${grid.width}×${grid.height}`, 'success');
                    
                    // 测试网格方法
                    if (grid.isEmpty && grid.canPlaceBlock) {
                        log('网格方法检查通过', 'success');
                    }
                }
                
                // 测试游戏引擎模块
                log('测试游戏引擎模块...');
                const gameModule = await import('./src/game/game.js');
                if (gameModule.GameEngine) {
                    const engine = new gameModule.GameEngine();
                    log('游戏引擎创建成功', 'success');
                    
                    const gameState = engine.getGameState();
                    log(`初始游戏状态: ${gameState.state}`, 'success');
                }
                
                // 测试分数模块
                log('测试分数模块...');
                const scoreModule = await import('./src/game/score.js');
                if (scoreModule.ScoreManager) {
                    const scoreManager = new scoreModule.ScoreManager();
                    log('分数管理器创建成功', 'success');
                    log(`初始分数: ${scoreManager.getCurrentScore()}`, 'success');
                }
                
                // 测试渲染器模块
                log('测试渲染器模块...');
                const renderModule = await import('./src/render/canvas-renderer.js');
                if (renderModule.CanvasRenderer) {
                    log('渲染器模块加载成功', 'success');
                }
                
                // 测试UI模块
                log('测试UI模块...');
                const uiModule = await import('./src/ui/ui-controller.js');
                if (uiModule.UIController) {
                    log('UI控制器模块加载成功', 'success');
                }
                
                // 测试主入口模块
                log('测试主入口模块...');
                const mainModule = await import('./src/main.js');
                log('主入口模块加载成功', 'success');
                
                log('所有模块测试完成！游戏功能完整可用。', 'success');
                log('请打开游戏进行功能验证。', 'info');
                
            } catch (error) {
                log(`模块测试失败: ${error.message}`, 'error');
                console.error('测试错误详情:', error);
            }
        };
        
        // 页面加载后自动运行简单测试
        setTimeout(() => {
            log('页面加载完成，点击"运行模块测试"按钮开始测试。');
        }, 1000);
    </script>
</body>
</html>