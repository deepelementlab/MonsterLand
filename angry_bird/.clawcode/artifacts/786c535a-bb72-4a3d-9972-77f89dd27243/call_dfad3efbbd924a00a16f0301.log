+## 4. 核心模块接口
+
+### 4.1 游戏对象接口
+
+```javascript
+// 小鸟接口
+class Bird {
+    constructor(scene, x, y, type = 'red') {
+        this.type = type;
+        this.launched = false;
+    }
+    
+    launch(velocity) {}    // 发射小鸟
+    useAbility() {}        // 使用特殊能力
+}
+
+// 方块接口
+class Block {
+    constructor(scene, x, y, material = 'wood') {
+        this.material = material;
+        this.health = this.getHealth(material);
+    }
+    
+    takeDamage(amount) {}  // 受到伤害
+    checkDestruction() {}  // 检查是否破坏
+}
+```
+
+### 4.2 系统接口
+
+```javascript
+// 得分系统接口
+class ScoreSystem {
+    addScore(points, x, y) {}  // 添加分数
+    setMultiplier(value) {}    // 设置连击倍率
+    calculateStars() {}        // 计算星级
+}
+
+// 输入系统接口
+class InputSystem {
+    onDragStart(pointer) {}    // 处理拖拽开始
+    onDragMove(pointer) {}     // 处理拖拽移动
+    onDragEnd(pointer) {}      // 处理拖拽结束
+}
+```
