+            soundVolume: 1.0,
+            musicVolume: 0.8
+        }
+    },
+    
+    // 关卡状态
+    level: {
+        score: 0,
+        birdsRemaining: 3,
+        pigsRemaining: 3,
+        isPlaying: false,
+        isPaused: false
+    }
+};
+```
