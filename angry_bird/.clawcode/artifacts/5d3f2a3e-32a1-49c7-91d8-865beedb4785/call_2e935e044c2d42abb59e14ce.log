{"success": true, "kind": "python", "stdout": "{'success': True, 'content': \"/**\\n * ϵͳģ\\n * ߼Matter.jsʼײ⡢崴͹켣\\n */\\nexport class PhysicsSystem {\\n    constructor(scene) {\\n        this.scene = scene;\\n        this.matter = scene.matter;\\n        this.world = scene.matter.world;\\n        this.engine = scene.matter.world.engine;\\n        \\n        // ײص\\n        this.collisionCallbacks = [];\\n        \\n        // \\n        this.config = {\\n            gravity: { x: 0, y: 1 },\\n            launchPower: 0.15,\\n            materials: {\\n                wood: {\\n                    health: 100,\\n                    density: 0.001,\\n                    friction: 0.5,\\n                    restitution: 0.3\\n                },\\n                stone: {\\n                    health: 300,\\n                    density: 0.003,\\n                    friction: 0.8,\\n                    restitution: 0.1\\n                },\\n                glass: {\\n                    health: 50,\\n                    density: 0.001,\\n                    friction: 0.2,\\n                    restitution: 0.5\\n                }\\n            }\\n        };\\n        \\n        // ʼ\\n        this.init({ gravity: this.config.gravity });\\n    }\\n    \\n    /**\\n     * ʼ\\n     * @param {Object} config - ò\\n     */\\n    init(config = {}) {\\n        // \\n        if (config.gravity) {\\n            this.world.setGravity(config.gravity.x, config.gravity.y);\\n        }\\n        \\n        // \\n        if (config.friction !== undefined) {\\n            this.engine.world.friction = config.friction;\\n        }\\n        \\n        if (config.restitution !== undefined) {\\n            this.engine.world.restitution = config.restitution;\\n        }\\n        \\n        // ײ¼\\n        this.setupCollisions();\\n        \\n        \\n    }\\n    \\n    /**\\n     * \\n     * @param {Object} options - ѡ\\n     * @param {string} options.type - : 'rectangle', 'circle', 'polygon'\\n     * @param {number} options.x - X\\n     * @param {number} options.y - Y\\n     * @param {number} options.width - ()\\n     * @param {number} options.height - ߶()\\n     * @param {number} options.radius - 뾶(Բ)\\n     * @param {Object} options.vertices - ()\\n     * @param {Object} options.material - \\n     * @param {boolean} options.isStatic - Ƿ̬\\n     * @param {string} options.label - ǩ\\n     * @returns {Object} Matter.js\\n     */\\n    createBody(options) {\\n        const { type = 'rectangle', x, y, material = 'wood', isStatic = false, label = 'body' } = options;\\n        \\n        // ȡ\\n        const materialProps = this.config.materials[material] || this.config.materials.wood;\\n        \\n        // \\n        const bodyOptions = {\\n            isStatic: isStatic,\\n            friction: materialProps.friction,\\n            restitution: materialProps.restitution,\\n            density: materialProps.density,\\n            label: label,\\n            material: material\\n        };\\n        \\n        let body;\\n        \\n        // ʹ\\n        switch (type) {\\n            case 'rectangle':\\n                body = this.matter.add.rectangle(x, y, options.width, options.height, bodyOptions);\\n                break;\\n                \\n            case 'circle':\\n                body = this.matter.add.circle(x, y, options.radius, bodyOptions);\\n                break;\\n                \\n            case 'polygon':\\n                body = this.matter.add.polygon(x, y, options.sides || 3, options.radius || 50, bodyOptions);\\n                break;\\n                \\n            default:\\n                console.warn(`Unknown body type: ${type}, defaulting to rectangle`);\\n                body = this.matter.add.rectangle(x, y, options.width || 50, options.height || 50, bodyOptions);\\n        }\\n        \\n        // 洢Ϣ\\n        body.material = material;\\n        body.health = materialProps.health;\\n        \\n        return body;\\n    }\\n    \\n    /**\\n     * עײص\\n     * @param {Function} callback - ײص\\n     */\\n    onCollision(callback) {\\n        if (typeof callback === 'function') {\\n            this.collisionCallbacks.push(callback);\\n        }\\n    }\\n    \\n    /**\\n     * ʩ\\n     * @param {Object} body - Matter.js\\n     * @param {Object} force -  {x, y}\\n     */\\n    applyForce(body, force) {\\n        if (body && force) {\\n            this.matter.body.applyForce(body, body.position, {\\n                x: force.x / body.mass,\\n                y: force.y / body.mass\\n            });\\n        }\\n    }\\n    \\n    /**\\n     * 㵯켣\\n     * @param {Object} startPos - ʼλ {x, y}\\n     * @param {Object} velocity - ʼٶ {x, y}\\n     * @param {number} steps - 켣\\n     * @returns {Array} 켣 [{x, y}, ...]\\n     */\\n    calculateTrajectory(startPos, velocity, steps = 10) {\\n        const points = [];\\n        const gravity = this.config.gravity.y;\\n        const launchPower = this.config.launchPower;\\n        \\n        // ٶȲ\\n        const vx = velocity.x * launchPower;\\n        const vy = velocity.y * launchPower;\\n        \\n        for (let i = 0; i < steps; i++) {\\n            const t = i * 0.1; // ʱ䲽\\n            const x = startPos.x + vx * t * 60; // 60FPS\\n            const y = startPos.y + vy * t * 60 + 0.5 * gravity * t * t * 3600;\\n            \\n            // Ƿ񳬳Ļײ\\n            if (y > 720) { // Ļ߶720\\n                break;\\n            }\\n            \\n            points.push({ x, y });\\n        }\\n        \\n        return points;\\n    }\\n    \\n    /**\\n     * \\n     * @param {Object} body - Matter.js\\n     */\\n    destroyBody(body) {\\n        if (body && this.world) {\\n            this.matter.world.remove(body);\\n        }\\n    }\\n    \\n    /**\\n     * ײ\\n     * @param {Object} bodyA - A\\n     * @param {Object} bodyB - B\\n     * @returns {number} ײС\\n     */\\n    calculateImpactForce(bodyA, bodyB) {\\n        const velocityA = bodyA.velocity;\\n        const velocityB = bodyB.velocity;\\n        const relativeVelocity = Math.sqrt(\\n            Math.pow(velocityA.x - velocityB.x, 2) + Math.pow(velocityA.y - velocityB.y, 2)\\n        );\\n        return relativeVelocity * (bodyA.mass + bodyB.mass) / 2;\\n    }\\n    \\n    /**\\n     * ȡ\\n     * @param {string} materialName - \\n     * @returns {Object} \\n     */\\n    getMaterialConfig(materialName) {\\n        return this.config.materials[materialName] || this.config.materials.wood;\\n    }\\n    \\n    /**\\n     * \\n     * @param {number} x - X\\n     * @param {number} y - Y\\n     */\\n    setGravity(x, y) {\\n        this.world.setGravity(x, y);\\n        this.config.gravity = { x, y };\\n    }\\n    \\n    /**\\n     * ȡǰ\\n     * @returns {Object}  {x, y}\\n     */\\n    getGravity() {\\n        return this.config.gravity;\\n    }\\n    \\n    /**\\n     * ײ¼\\n     */\\n    setupCollisions() {\\n        // Ƴеײ\\n        this.world.off('collisionstart');\\n        \\n        // µײ\\n        this.world.on('collisionstart', (event) => {\\n            event.pairs.forEach(pair => {\\n                const bodyA = pair.bodyA;\\n                const bodyB = pair.bodyB;\\n                \\n                // ײ\\n                const impactForce = this.calculateImpactForce(bodyA, bodyB);\\n                \\n                // עײص\\n                this.collisionCallbacks.forEach(callback => {\\n                    callback(bodyA, bodyB, impactForce);\\n                });\\n            });\\n        });\\n    }\\n    \\n    /**\\n     * ȡ\\n     * @returns {Array} \\n     */\\n    getAllBodies() {\\n        return this.engine.world.bodies;\\n    }\\n    \\n    /**\\n     * Ƿ嶼ֹ\\n     * @param {number} threshold - ٶֵ\\n     * @returns {boolean} Ƿȫֹ\\n     */\\n    isAllSleeping(threshold = 0.5) {\\n        return this.getAllBodies().every(\\n            body => body.isStatic || body.speed < threshold\\n        );\\n    }\\n    \\n    /**\\n     * \\n     */\\n    cleanup() {\\n        // Ƴײص\\n        this.collisionCallbacks = [];\\n        \\n        // Ƴ壨˾̬棩\\n        const bodies = this.getAllBodies();\\n        bodies.forEach(body => {\\n            if (!body.isStatic || body.label !== 'ground') {\\n                this.destroyBody(body);\\n            }\\n        });\\n        \\n        \\n    }\\n}\\n\", 'total_lines': 298}\r\n", "stderr": "", "returncode": 0}