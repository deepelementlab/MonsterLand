{"success": true, "kind": "shell", "stdout": "/**\n * 物理系统模块\n * 处理所有物理引擎逻辑，包括Matter.js物理世界初始化、碰撞检测、物体创建和轨迹计算\n */\nexport class PhysicsSystem {\n    constructor(scene) {\n        this.scene = scene;\n        this.matter = scene.matter;\n        this.world = scene.matter.world;\n        this.engine = scene.matter.world.engine;\n        \n        // 碰撞回调集合\n        this.collisionCallbacks = [];\n        \n        // 物理参数配置\n        this.config = {\n            gravity: { x: 0, y: 1 },\n            launchPower: 0.15,\n            materials: {\n                wood: {\n                    health: 100,\n                    density: 0.001,\n                    friction: 0.5,\n                    restitution: 0.3\n                },\n                stone: {\n                    health: 300,\n                    density: 0.003,\n                    friction: 0.8,\n                    restitution: 0.1\n                },\n                glass: {\n                    health: 50,\n                    density: 0.001,\n                    friction: 0.2,\n                    restitution: 0.5\n                }\n            }\n        };\n        \n        // 初始化物理世界\n        this.init({ gravity: this.config.gravity });\n    }\n    \n    /**\n     * 初始化物理世界\n     * @param {Object} config - 配置参数\n     */\n    init(config = {}) {\n        // 设置重力\n        if (config.gravity) {\n            this.world.setGravity(config.gravity.x, config.gravity.y);\n        }\n        \n        // 设置物理引擎配置\n        if (config.friction !== undefined) {\n            this.engine.world.friction = config.friction;\n        }\n        \n        if (config.restitution !== undefined) {\n            this.engine.world.restitution = config.restitution;\n        }\n        \n        // 设置碰撞事件\n        this.setupCollisions();\n        \n        \n    }\n    \n    /**\n     * 创建物理体\n     * @param {Object} options - 物体选项\n     * @param {string} options.type - 物体类型: 'rectangle', 'circle', 'polygon'\n     * @param {number} options.x - X坐标\n     * @param {number} options.y - Y坐标\n     * @param {number} options.width - 宽度(矩形)\n     * @param {number} options.height - 高度(矩形)\n     * @param {number} options.radius - 半径(圆形)\n     * @param {Object} options.vertices - 顶点数组(多边形)\n     * @param {Object} options.material - 材质配置\n     * @param {boolean} options.isStatic - 是否静态\n     * @param {string} options.label - 物体标签\n     * @returns {Object} Matter.js物理体\n     */\n    createBody(options) {\n        const { type = 'rectangle', x, y, material = 'wood', isStatic = false, label = 'body' } = options;\n        \n        // 获取材质属性\n        const materialProps = this.config.materials[material] || this.config.materials.wood;\n        \n        // 基本物理属性\n        const bodyOptions = {\n            isStatic: isStatic,\n            friction: materialProps.friction,\n            restitution: materialProps.restitution,\n            density: materialProps.density,\n            label: label,\n            material: material\n        };\n        \n        let body;\n        \n        // 根据类型创建物体\n        switch (type) {\n            case 'rectangle':\n                body = this.matter.add.rectangle(x, y, options.width, options.height, bodyOptions);\n                break;\n                \n            case 'circle':\n                body = this.matter.add.circle(x, y, options.radius, bodyOptions);\n                break;\n                \n            case 'polygon':\n                body = this.matter.add.polygon(x, y, options.sides || 3, options.radius || 50, bodyOptions);\n                break;\n                \n            default:\n                console.warn(`Unknown body type: ${type}, defaulting to rectangle`);\n                body = this.matter.add.rectangle(x, y, options.width || 50, options.height || 50, bodyOptions);\n        }\n        \n        // 存储材质信息\n        body.material = material;\n        body.health = materialProps.health;\n        \n        return body;\n    }\n    \n    /**\n     * 注册碰撞回调\n     * @param {Function} callback - 碰撞回调函数\n     */\n    onCollision(callback) {\n        if (typeof callback === 'function') {\n            this.collisionCallbacks.push(callback);\n        }\n    }\n    \n    /**\n     * 施加力到物体\n     * @param {Object} body - Matter.js物理体\n     * @param {Object} force - 力对象 {x, y}\n     */\n    applyForce(body, force) {\n        if (body && force) {\n            this.matter.body.applyForce(body, body.position, {\n                x: force.x / body.mass,\n                y: force.y / body.mass\n            });\n        }\n    }\n    \n    /**\n     * 计算弹道轨迹\n     * @param {Object} startPos - 起始位置 {x, y}\n     * @param {Object} velocity - 初始速度 {x, y}\n     * @param {number} steps - 轨迹点数\n     * @returns {Array} 轨迹点数组 [{x, y}, ...]\n     */\n    calculateTrajectory(startPos, velocity, steps = 10) {\n        const points = [];\n        const gravity = this.config.gravity.y;\n        const launchPower = this.config.launchPower;\n        \n        // 调整速度参数\n        const vx = velocity.x * launchPower;\n        const vy = velocity.y * launchPower;\n        \n        for (let i = 0; i < steps; i++) {\n            const t = i * 0.1; // 时间步长\n            const x = startPos.x + vx * t * 60; // 假设60FPS\n            const y = startPos.y + vy * t * 60 + 0.5 * gravity * t * t * 3600;\n            \n            // 检查是否超出屏幕或碰撞地面\n            if (y > 720) { // 假设屏幕高度720\n                break;\n            }\n            \n            points.push({ x, y });\n        }\n        \n        return points;\n    }\n    \n    /**\n     * 销毁物理体\n     * @param {Object} body - Matter.js物理体\n     */\n    destroyBody(body) {\n        if (body && this.world) {\n            this.matter.world.remove(body);\n        }\n    }\n    \n    /**\n     * 计算碰撞力\n     * @param {Object} bodyA - 物体A\n     * @param {Object} bodyB - 物体B\n     * @returns {number} 碰撞力大小\n     */\n    calculateImpactForce(bodyA, bodyB) {\n        const velocityA = bodyA.velocity;\n        const velocityB = bodyB.velocity;\n        const relativeVelocity = Math.sqrt(\n            Math.pow(velocityA.x - velocityB.x, 2) + Math.pow(velocityA.y - velocityB.y, 2)\n        );\n        return relativeVelocity * (bodyA.mass + bodyB.mass) / 2;\n    }\n    \n    /**\n     * 获取材质配置\n     * @param {string} materialName - 材质名称\n     * @returns {Object} 材质配置\n     */\n    getMaterialConfig(materialName) {\n        return this.config.materials[materialName] || this.config.materials.wood;\n    }\n    \n    /**\n     * 设置重力\n     * @param {number} x - X方向重力\n     * @param {number} y - Y方向重力\n     */\n    setGravity(x, y) {\n        this.world.setGravity(x, y);\n        this.config.gravity = { x, y };\n    }\n    \n    /**\n     * 获取当前重力\n     * @returns {Object} 重力对象 {x, y}\n     */\n    getGravity() {\n        return this.config.gravity;\n    }\n    \n    /**\n     * 设置碰撞事件监听\n     */\n    setupCollisions() {\n        // 移除已有的碰撞监听器\n        this.world.off('collisionstart');\n        \n        // 设置新的碰撞监听器\n        this.world.on('collisionstart', (event) => {\n            event.pairs.forEach(pair => {\n                const bodyA = pair.bodyA;\n                const bodyB = pair.bodyB;\n                \n                // 计算碰撞力\n                const impactForce = this.calculateImpactForce(bodyA, bodyB);\n                \n                // 调用所有注册的碰撞回调\n                this.collisionCallbacks.forEach(callback => {\n                    callback(bodyA, bodyB, impactForce);\n                });\n            });\n        });\n    }\n    \n    /**\n     * 获取所有物理体\n     * @returns {Array} 物理体数组\n     */\n    getAllBodies() {\n        return this.engine.world.bodies;\n    }\n    \n    /**\n     * 检查是否所有物体都静止\n     * @param {number} threshold - 速度阈值\n     * @returns {boolean} 是否全部静止\n     */\n    isAllSleeping(threshold = 0.5) {\n        return this.getAllBodies().every(\n            body => body.isStatic || body.speed < threshold\n        );\n    }\n    \n    /**\n     * 清理物理世界\n     */\n    cleanup() {\n        // 移除所有碰撞回调\n        this.collisionCallbacks = [];\n        \n        // 移除所有物体（除了静态地面）\n        const bodies = this.getAllBodies();\n        bodies.forEach(body => {\n            if (!body.isStatic || body.label !== 'ground') {\n                this.destroyBody(body);\n            }\n        });\n        \n        \n    }\n}\n\n", "stderr": "", "returncode": 0, "backend": "local"}