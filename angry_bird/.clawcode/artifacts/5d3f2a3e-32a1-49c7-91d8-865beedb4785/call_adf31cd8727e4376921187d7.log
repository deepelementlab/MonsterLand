    release() {
        // 释放动画效果
        this.scene.tweens.add({
            targets: this.band,
            alpha: 0.5,
            duration: 50,
            yoyo: true,
            onComplete: () => {
                this.resetBand();
            }
        });
    }
    
    destroy() {
        this.graphics.destroy();
        this.band.destroy();
    }
