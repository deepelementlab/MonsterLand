    }
    
    /**
     * 计算弹道轨迹
     * @param {Object} startPos - 起始位置 {x, y}
     * @param {Object} velocity - 初始速度 {x, y}
     * @param {number} steps - 轨迹点数
     * @returns {Array} 轨迹点数组 [{x, y}, ...]
     */
    calculateTrajectory(startPos, velocity, steps = 10) {
        const points = [];
        const gravity = this.config.gravity.y;
        const launchPower = this.config.launchPower;
        
        // 调整速度参数
        const vx = velocity.x * launchPower;
        const vy = velocity.y * launchPower;
        
        for (let i = 0; i < steps; i++) {
            const t = i * 0.1; // 时间步长
            const x = startPos.x + vx * t * 60; // 假设60FPS
            const y = startPos.y + vy * t * 60 + 0.5 * gravity * t * t * 3600;
            
            // 检查是否超出屏幕或碰撞地面
            if (y > 720) { // 假设屏幕高度720
                break;
            }
            
            points.push({ x, y });
        }
        
        return points;
    }
    
    /**
     * 销毁物理体
     * @param {Object} body - Matter.js物理体
     */
    destroyBody(body) {
        if (body && this.world) {
            this.matter.world.remove(body);
        }
    }
    
    /**
     * 计算碰撞力
     * @param {Object} bodyA - 物体A
     * @param {Object} bodyB - 物体B
     * @returns {number} 碰撞力大小
     */
    calculateImpactForce(bodyA, bodyB) {
        const velocityA = bodyA.velocity;
        const velocityB = bodyB.velocity;
        const relativeVelocity = Math.sqrt(
            Math.pow(velocityA.x - velocityB.x, 2) + Math.pow(velocityA.y - velocityB.y, 2)
        );
        return relativeVelocity * (bodyA.mass + bodyB.mass) / 2;
    }
    
    /**
     * 获取材质配置
     * @param {string} materialName - 材质名称
     * @returns {Object} 材质配置
     */
    getMaterialConfig(materialName) {
        return this.config.materials[materialName] || this.config.materials.wood;
    }
    
    /**
     * 设置重力
     * @param {number} x - X方向重力
     * @param {number} y - Y方向重力
     */
    setGravity(x, y) {
        this.world.setGravity(x, y);
        this.config.gravity = { x, y };
    }
    
    /**
     * 获取当前重力
     * @returns {Object} 重力对象 {x, y}
     */
    getGravity() {
        return this.config.gravity;
    }
    
    /**
     * 设置碰撞事件监听
     */
    setupCollisions() {
        // 移除已有的碰撞监听器
        this.world.off('collisionstart');
        
        // 设置新的碰撞监听器
        this.world.on('collisionstart', (event) => {
            event.pairs.forEach(pair => {
                const bodyA = pair.bodyA;
                const bodyB = pair.bodyB;
                
                // 计算碰撞力
                const impactForce = this.calculateImpactForce(bodyA, bodyB);
                
                // 调用所有注册的碰撞回调
                this.collisionCallbacks.forEach(callback => {
                    callback(bodyA, bodyB, impactForce);
                });
            });
        });
    }
    
    /**
     * 获取所有物理体
     * @returns {Array} 物理体数组
     */
    getAllBodies() {
        return this.engine.world.bodies;
    }
    
    /**
     * 检查是否所有物体都静止
     * @param {number} threshold - 速度阈值
     * @returns {boolean} 是否全部静止
     */
    isAllSleeping(threshold = 0.5) {
        return this.getAllBodies().every(
            body => body.isStatic || body.speed < threshold
        );
    }
    
    /**
     * 清理物理世界
     */
    cleanup() {
        // 移除所有碰撞回调
        this.collisionCallbacks = [];
        
        // 移除所有物体（除了静态地面）
        const bodies = this.getAllBodies();
        bodies.forEach(body => {
            if (!body.isStatic || body.label !== 'ground') {
                this.destroyBody(body);
            }
        });
        
        
    }
}
