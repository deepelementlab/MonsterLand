/**
 * 物理系统模块
 * 处理所有物理引擎逻辑，包括Matter.js物理世界初始化、碰撞检测、物体创建和轨迹计算
 */
export class PhysicsSystem {
    constructor(scene) {
        this.scene = scene;
        this.matter = scene.matter;
        this.world = scene.matter.world;
        this.engine = scene.matter.world.engine;
        
        // 碰撞回调集合
        this.collisionCallbacks = [];
        
        // 物理参数配置
        this.config = {
            gravity: { x: 0, y: 1 },
            launchPower: 0.15,
            materials: {
                wood: {
                    health: 100,
                    density: 0.001,
                    friction: 0.5,
                    restitution: 0.3
                },
                stone: {
                    health: 300,
                    density: 0.003,
                    friction: 0.8,
                    restitution: 0.1
                },
                glass: {
                    health: 50,
                    density: 0.001,
                    friction: 0.2,
                    restitution: 0.5
                }
            }
        };
        
        // 初始化物理世界
        this.init({ gravity: this.config.gravity });
    }
    
    /**
     * 初始化物理世界
     * @param {Object} config - 配置参数
     */
    init(config = {}) {
        // 设置重力
        if (config.gravity) {
            this.world.setGravity(config.gravity.x, config.gravity.y);
        }
        
        // 设置物理引擎配置
        if (config.friction !== undefined) {
            this.engine.world.friction = config.friction;
        }
        
        if (config.restitution !== undefined) {
            this.engine.world.restitution = config.restitution;
        }
        
        // 设置碰撞事件
        this.setupCollisions();
        
        
    }
    
    /**
     * 创建物理体
     * @param {Object} options - 物体选项
     * @param {string} options.type - 物体类型: 'rectangle', 'circle', 'polygon'
     * @param {number} options.x - X坐标
     * @param {number} options.y - Y坐标
     * @param {number} options.width - 宽度(矩形)
     * @param {number} options.height - 高度(矩形)
     * @param {number} options.radius - 半径(圆形)
     * @param {Object} options.vertices - 顶点数组(多边形)
     * @param {Object} options.material - 材质配置
     * @param {boolean} options.isStatic - 是否静态
     * @param {string} options.label - 物体标签
     * @returns {Object} Matter.js物理体
     */
    createBody(options) {
        const { type = 'rectangle', x, y, material = 'wood', isStatic = false, label = 'body' } = options;
        
        // 获取材质属性
        const materialProps = this.config.materials[material] || this.config.materials.wood;
        
        // 基本物理属性
        const bodyOptions = {
            isStatic: isStatic,
            friction: materialProps.friction,
            restitution: materialProps.restitution,
            density: materialProps.density,
            label: label,
            material: material
        };
        
        let body;
        
        // 根据类型创建物体
        switch (type) {
            case 'rectangle':
                body = this.matter.add.rectangle(x, y, options.width, options.height, bodyOptions);
                break;
                
            case 'circle':
                body = this.matter.add.circle(x, y, options.radius, bodyOptions);
                break;
                
            case 'polygon':
                body = this.matter.add.polygon(x, y, options.sides || 3, options.radius || 50, bodyOptions);
                break;
                
            default:
                console.warn(`Unknown body type: ${type}, defaulting to rectangle`);
                body = this.matter.add.rectangle(x, y, options.width || 50, options.height || 50, bodyOptions);
        }
        
        // 存储材质信息
        body.material = material;
        body.health = materialProps.health;
        
        return body;
    }
    
    /**
     * 注册碰撞回调
     * @param {Function} callback - 碰撞回调函数
     */
    onCollision(callback) {
        if (typeof callback === 'function') {
            this.collisionCallbacks.push(callback);
        }
    }
    
    /**
     * 施加力到物体
     * @param {Object} body - Matter.js物理体
     * @param {Object} force - 力对象 {x, y}
     */
    applyForce(body, force) {
        if (body && force) {
            this.matter.body.applyForce(body, body.position, {
                x: force.x / body.mass,
                y: force.y / body.mass
            });
        }

