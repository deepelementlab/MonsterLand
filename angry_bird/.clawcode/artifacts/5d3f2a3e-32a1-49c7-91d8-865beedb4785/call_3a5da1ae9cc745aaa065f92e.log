{"success": true, "kind": "python", "stdout": "0: /**\r\n * ϵͳģ\r\n * ߼Matter.jsʼײ⡢崴͹켣\r\n */\r\nexport class PhysicsSystem {\r\n    constructor(scene) {\r\n        this.scene = scene;\r\n        this.matter = scene.matter;\r\n        this.world = scene.matter.world;\r\n        this.engine = scene.matter.world.engine;\r\n        \r\n        // ײص\r\n        this.collisionCallbacks = [];\r\n        \r\n        // \r\n        this.config = {\r\n            gravity: { x: 0, y: 1 },\r\n            launchPower: 0.15,\r\n            materials: {\r\n                wood: {\r\n                    health: 100,\r\n                    density: 0.001,\r\n                    friction: 0.5,\r\n                    restitution: 0.3\r\n                },\r\n                stone: {\r\n                    health: 300,\r\n                    density: 0.003,\r\n                    friction: 0.8,\r\n                    restitution: 0.1\r\n                },\r\n                glass: {\r\n                    health: 50,\r\n                    density: 0.001,\r\n                    friction: 0.2,\r\n                    restitution: 0.5\r\n                }\r\n            }\r\n        };\r\n        \r\n        // ʼ\r\n        this.init({ gravity: this.config.gravity });\r\n    }\r\n    \r\n    /**\r\n     * ʼ\r\n     * @param {Object} config - ò\r\n     */\r\n    init(config = {}) {\r\n        // \r\n        if (config.gravity) {\r\n            this.world.setGravity(config.gravity.x, config.gravity.y);\r\n        }\r\n        \r\n        // \r\n        if (config.friction !== undefined) {\r\n            this.engine.world.friction = config.friction;\r\n        }\r\n        \r\n        if (config.restitution !== undefined) {\r\n            this.engine.world.restitution = config.restitution;\r\n        }\r\n        \r\n        // ײ¼\r\n        this.setupCollisions();\r\n        \r\n        \r\n    }\r\n    \r\n    /**\r\n     * \r\n     * @param {Object} options - ѡ\r\n     * @param {string} options.type - : 'rectangle', 'circle', 'polygon'\r\n     * @param {number} options.x - X\r\n     * @param {number} options.y - Y\r\n     * @param {number} options.width - ()\r\n     * @param {number} options.height - ߶()\r\n     * @param {number} options.radius - 뾶(Բ)\r\n     * @param {Object} options.vertices - ()\r\n     * @param {Object} options.material - \r\n     * @param {boolean} options.isStatic - Ƿ̬\r\n     * @param {string} options.label - ǩ\r\n     * @returns {Object} Matter.js\r\n     */\r\n    createBody(options) {\r\n        const { type = 'rectangle', x, y, material = 'wood', isStatic = false, label = 'body' } = options;\r\n        \r\n        // ȡ\r\n        const materialProps = this.config.materials[material] || this.config.materials.wood;\r\n        \r\n        // \r\n        const bodyOptions = {\r\n            isStatic: isStatic,\r\n            friction: materialProps.friction,\r\n            restitution: materialProps.restitution,\r\n            density: materialProps.density,\r\n            label: label,\r\n            material: material\r\n        };\r\n        \r\n        let body;\r\n        \r\n        // ʹ\r\n        switch (type) {\r\n            case 'rectangle':\r\n                body = this.matter.add.rectangle(x, y, options.width, options.height, bodyOptions);\r\n                break;\r\n                \r\n            case 'circle':\r\n                body = this.matter.add.circle(x, y, options.radius, bodyOptions);\r\n                break;\r\n                \r\n            case 'polygon':\r\n                body = this.matter.add.polygon(x, y, options.sides || 3, options.radius || 50, bodyOptions);\r\n                break;\r\n                \r\n            default:\r\n                console.warn(`Unknown body type: ${type}, defaulting to rectangle`);\r\n                body = this.matter.add.rectangle(x, y, options.width || 50, options.height || 50, bodyOptions);\r\n        }\r\n        \r\n        // 洢Ϣ\r\n        body.material = material;\r\n        body.health = materialProps.health;\r\n        \r\n        return body;\r\n    }\r\n    \r\n    /**\r\n     * עײص\r\n     * @param {Function} callback - ײص\r\n     */\r\n    onCollision(callback) {\r\n        if (typeof callback === 'function') {\r\n            this.collisionCallbacks.push(callback);\r\n        }\r\n    }\r\n    \r\n    /**\r\n     * ʩ\r\n     * @param {Object} body - Matter.js\r\n     * @param {Object} force -  {x, y}\r\n     */\r\n    applyForce(body, force) {\r\n        if (body && force) {\r\n            this.matter.body.applyForce(body, body.position, {\r\n                x: force.x / body.mass,\r\n                y: force.y / body.mass\r\n            });\r\n        }\r\n    }\r\n    \r\n    /**\r\n     * 㵯켣\r\n     * @param {Object} startPos - ʼλ {x, y}\r\n     * @param {Object} velocity - ʼٶ {x, y}\r\n     * @param {number} steps - 켣\r\n     * @returns {Array} 켣 [{x, y}, ...]\r\n     */\r\n    calculateTrajectory(startPos, velocity, steps = 10) {\r\n        const points = [];\r\n        const gravity = this.config.gravity.y;\r\n        const launchPower = this.config.launchPower;\r\n        \r\n        // ٶȲ\r\n        const vx = velocity.x * launchPower;\r\n        const vy = velocity.y * launchPower;\r\n        \r\n        for (let i = 0; i < steps; i++) {\r\n            const t = i * 0.1; // ʱ䲽\r\n            const x = startPos.x + vx * t * 60; // 60FPS\r\n            const y = startPos.y + vy * t * 60 + 0.5 * gravity * t * t * 3600;\r\n            \r\n            // Ƿ񳬳Ļײ\r\n            if (y > 720) { // Ļ߶720\r\n                break;\r\n            }\r\n            \r\n            points.push({ x, y });\r\n        }\r\n        \r\n        return points;\r\n    }\r\n    \r\n    /**\r\n     * \r\n     * @param {Object} body - Matter.js\r\n     */\r\n    destroyBody(body) {\r\n        if (body && this.world) {\r\n            this.matter.world.remove(body);\r\n        }\r\n    }\r\n    \r\n    /**\r\n     * ײ\r\n     * @param {Object} bodyA - A\r\n     * @param {Object} bodyB - B\r\n     * @returns {number} ײС\r\n     */\r\n    calculateImpactForce(bodyA, bodyB) {\r\n        const velocityA = bodyA.velocity;\r\n        const velocityB = bodyB.velocity;\r\n        const relativeVelocity = Math.sqrt(\r\n            Math.pow(velocityA.x - velocityB.x, 2) + Math.pow(velocityA.y - velocityB.y, 2)\r\n        );\r\n        return relativeVelocity * (bodyA.mass + bodyB.mass) / 2;\r\n    }\r\n    \r\n    /**\r\n     * ȡ\r\n     * @param {string} materialName - \r\n     * @returns {Object} \r\n     */\r\n    getMaterialConfig(materialName) {\r\n        return this.config.materials[materialName] || this.config.materials.wood;\r\n    }\r\n    \r\n    /**\r\n     * \r\n     * @param {number} x - X\r\n     * @param {number} y - Y\r\n     */\r\n    setGravity(x, y) {\r\n        this.world.setGravity(x, y);\r\n        this.config.gravity = { x, y };\r\n    }\r\n    \r\n    /**\r\n     * ȡǰ\r\n     * @returns {Object}  {x, y}\r\n     */\r\n    getGravity() {\r\n        return this.config.gravity;\r\n    }\r\n    \r\n    /**\r\n     * ײ¼\r\n     */\r\n    setupCollisions() {\r\n        // Ƴеײ\r\n        this.world.off('collisionstart');\r\n        \r\n        // µײ\r\n        this.world.on('collisionstart', (event) => {\r\n            event.pairs.forEach(pair => {\r\n                const bodyA = pair.bodyA;\r\n                const bodyB = pair.bodyB;\r\n                \r\n                // ײ\r\n                const impactForce = this.calculateImpactForce(bodyA, bodyB);\r\n                \r\n                // עײص\r\n                this.collisionCallbacks.forEach(callback => {\r\n                    callback(bodyA, bodyB, impactForce);\r\n                });\r\n            });\r\n        });\r\n    }\r\n    \r\n    /**\r\n     * ȡ\r\n     * @returns {Array} \r\n     */\r\n    getAllBodies() {\r\n        return this.engine.world.bodies;\r\n    }\r\n    \r\n    /**\r\n     * Ƿ嶼ֹ\r\n     * @param {number} threshold - ٶֵ\r\n     * @returns {boolean} Ƿȫֹ\r\n     */\r\n    isAllSleeping(threshold = 0.5) {\r\n        return this.getAllBodies().every(\r\n            body => body.isStatic || body.speed < threshold\r\n        );\r\n    }\r\n    \r\n    /**\r\n     * \r\n     */\r\n    cleanup() {\r\n        // Ƴײص\r\n        this.collisionCallbacks = [];\r\n        \r\n        // Ƴ壨˾̬棩\r\n        const bodies = this.getAllBodies();\r\n        bodies.forEach(body => {\r\n            if (!body.isStatic || body.label !== 'ground') {\r\n                this.destroyBody(body);\r\n            }\r\n        });\r\n        \r\n        \r\n    }\r\n}\r\n\r\n", "stderr": "", "returncode": 0}