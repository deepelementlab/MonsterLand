{"success": true, "kind": "python", "stdout": "0: /**\r\n1:  * ϵͳģ\r\n2:  * ߼Matter.jsʼײ⡢崴͹켣\r\n3:  */\r\n4: export class PhysicsSystem {\r\n5:     constructor(scene) {\r\n6:         this.scene = scene;\r\n7:         this.matter = scene.matter;\r\n8:         this.world = scene.matter.world;\r\n9:         this.engine = scene.matter.world.engine;\r\n10:         \r\n11:         // ײص\r\n12:         this.collisionCallbacks = [];\r\n13:         \r\n14:         // \r\n15:         this.config = {\r\n16:             gravity: { x: 0, y: 1 },\r\n17:             launchPower: 0.15,\r\n18:             materials: {\r\n19:                 wood: {\r\n20:                     health: 100,\r\n21:                     density: 0.001,\r\n22:                     friction: 0.5,\r\n23:                     restitution: 0.3\r\n24:                 },\r\n25:                 stone: {\r\n26:                     health: 300,\r\n27:                     density: 0.003,\r\n28:                     friction: 0.8,\r\n29:                     restitution: 0.1\r\n30:                 },\r\n31:                 glass: {\r\n32:                     health: 50,\r\n33:                     density: 0.001,\r\n34:                     friction: 0.2,\r\n35:                     restitution: 0.5\r\n36:                 }\r\n37:             }\r\n38:         };\r\n39:         \r\n40:         // ʼ\r\n41:         this.init({ gravity: this.config.gravity });\r\n42:     }\r\n43:     \r\n44:     /**\r\n45:      * ʼ\r\n46:      * @param {Object} config - ò\r\n47:      */\r\n48:     init(config = {}) {\r\n49:         // \r\n50:         if (config.gravity) {\r\n51:             this.world.setGravity(config.gravity.x, config.gravity.y);\r\n52:         }\r\n53:         \r\n54:         // \r\n55:         if (config.friction !== undefined) {\r\n56:             this.engine.world.friction = config.friction;\r\n57:         }\r\n58:         \r\n59:         if (config.restitution !== undefined) {\r\n60:             this.engine.world.restitution = config.restitution;\r\n61:         }\r\n62:         \r\n63:         // ײ¼\r\n64:         this.setupCollisions();\r\n65:         \r\n66:         \r\n67:     }\r\n68:     \r\n69:     /**\r\n70:      * \r\n71:      * @param {Object} options - ѡ\r\n72:      * @param {string} options.type - : 'rectangle', 'circle', 'polygon'\r\n73:      * @param {number} options.x - X\r\n74:      * @param {number} options.y - Y\r\n75:      * @param {number} options.width - ()\r\n76:      * @param {number} options.height - ߶()\r\n77:      * @param {number} options.radius - 뾶(Բ)\r\n78:      * @param {Object} options.vertices - ()\r\n79:      * @param {Object} options.material - \r\n80:      * @param {boolean} options.isStatic - Ƿ̬\r\n81:      * @param {string} options.label - ǩ\r\n82:      * @returns {Object} Matter.js\r\n83:      */\r\n84:     createBody(options) {\r\n85:         const { type = 'rectangle', x, y, material = 'wood', isStatic = false, label = 'body' } = options;\r\n86:         \r\n87:         // ȡ\r\n88:         const materialProps = this.config.materials[material] || this.config.materials.wood;\r\n89:         \r\n90:         // \r\n91:         const bodyOptions = {\r\n92:             isStatic: isStatic,\r\n93:             friction: materialProps.friction,\r\n94:             restitution: materialProps.restitution,\r\n95:             density: materialProps.density,\r\n96:             label: label,\r\n97:             material: material\r\n98:         };\r\n99:         \r\n100:         let body;\r\n101:         \r\n102:         // ʹ\r\n103:         switch (type) {\r\n104:             case 'rectangle':\r\n105:                 body = this.matter.add.rectangle(x, y, options.width, options.height, bodyOptions);\r\n106:                 break;\r\n107:                 \r\n108:             case 'circle':\r\n109:                 body = this.matter.add.circle(x, y, options.radius, bodyOptions);\r\n110:                 break;\r\n111:                 \r\n112:             case 'polygon':\r\n113:                 body = this.matter.add.polygon(x, y, options.sides || 3, options.radius || 50, bodyOptions);\r\n114:                 break;\r\n115:                 \r\n116:             default:\r\n117:                 console.warn(`Unknown body type: ${type}, defaulting to rectangle`);\r\n118:                 body = this.matter.add.rectangle(x, y, options.width || 50, options.height || 50, bodyOptions);\r\n119:         }\r\n120:         \r\n121:         // 洢Ϣ\r\n122:         body.material = material;\r\n123:         body.health = materialProps.health;\r\n124:         \r\n125:         return body;\r\n126:     }\r\n127:     \r\n128:     /**\r\n129:      * עײص\r\n130:      * @param {Function} callback - ײص\r\n131:      */\r\n132:     onCollision(callback) {\r\n133:         if (typeof callback === 'function') {\r\n134:             this.collisionCallbacks.push(callback);\r\n135:         }\r\n136:     }\r\n137:     \r\n138:     /**\r\n139:      * ʩ\r\n140:      * @param {Object} body - Matter.js\r\n141:      * @param {Object} force -  {x, y}\r\n142:      */\r\n143:     applyForce(body, force) {\r\n144:         if (body && force) {\r\n145:             this.matter.body.applyForce(body, body.position, {\r\n146:                 x: force.x / body.mass,\r\n147:                 y: force.y / body.mass\r\n148:             });\r\n149:         }\r\n150:     }\r\n151:     \r\n152:     /**\r\n153:      * 㵯켣\r\n154:      * @param {Object} startPos - ʼλ {x, y}\r\n155:      * @param {Object} velocity - ʼٶ {x, y}\r\n156:      * @param {number} steps - 켣\r\n157:      * @returns {Array} 켣 [{x, y}, ...]\r\n158:      */\r\n159:     calculateTrajectory(startPos, velocity, steps = 10) {\r\n160:         const points = [];\r\n161:         const gravity = this.config.gravity.y;\r\n162:         const launchPower = this.config.launchPower;\r\n163:         \r\n164:         // ٶȲ\r\n165:         const vx = velocity.x * launchPower;\r\n166:         const vy = velocity.y * launchPower;\r\n167:         \r\n168:         for (let i = 0; i < steps; i++) {\r\n169:             const t = i * 0.1; // ʱ䲽\r\n170:             const x = startPos.x + vx * t * 60; // 60FPS\r\n171:             const y = startPos.y + vy * t * 60 + 0.5 * gravity * t * t * 3600;\r\n172:             \r\n173:             // Ƿ񳬳Ļײ\r\n174:             if (y > 720) { // Ļ߶720\r\n175:                 break;\r\n176:             }\r\n177:             \r\n178:             points.push({ x, y });\r\n179:         }\r\n180:         \r\n181:         return points;\r\n182:     }\r\n183:     \r\n184:     /**\r\n185:      * \r\n186:      * @param {Object} body - Matter.js\r\n187:      */\r\n188:     destroyBody(body) {\r\n189:         if (body && this.world) {\r\n190:             this.matter.world.remove(body);\r\n191:         }\r\n192:     }\r\n193:     \r\n194:     /**\r\n195:      * ײ\r\n196:      * @param {Object} bodyA - A\r\n197:      * @param {Object} bodyB - B\r\n198:      * @returns {number} ײС\r\n199:      */\r\n200:     calculateImpactForce(bodyA, bodyB) {\r\n201:         const velocityA = bodyA.velocity;\r\n202:         const velocityB = bodyB.velocity;\r\n203:         const relativeVelocity = Math.sqrt(\r\n204:             Math.pow(velocityA.x - velocityB.x, 2) + Math.pow(velocityA.y - velocityB.y, 2)\r\n205:         );\r\n206:         return relativeVelocity * (bodyA.mass + bodyB.mass) / 2;\r\n207:     }\r\n208:     \r\n209:     /**\r\n210:      * ȡ\r\n211:      * @param {string} materialName - \r\n212:      * @returns {Object} \r\n213:      */\r\n214:     getMaterialConfig(materialName) {\r\n215:         return this.config.materials[materialName] || this.config.materials.wood;\r\n216:     }\r\n217:     \r\n218:     /**\r\n219:      * \r\n220:      * @param {number} x - X\r\n221:      * @param {number} y - Y\r\n222:      */\r\n223:     setGravity(x, y) {\r\n224:         this.world.setGravity(x, y);\r\n225:         this.config.gravity = { x, y };\r\n226:     }\r\n227:     \r\n228:     /**\r\n229:      * ȡǰ\r\n230:      * @returns {Object}  {x, y}\r\n231:      */\r\n232:     getGravity() {\r\n233:         return this.config.gravity;\r\n234:     }\r\n235:     \r\n236:     /**\r\n237:      * ײ¼\r\n238:      */\r\n239:     setupCollisions() {\r\n240:         // Ƴеײ\r\n241:         this.world.off('collisionstart');\r\n242:         \r\n243:         // µײ\r\n244:         this.world.on('collisionstart', (event) => {\r\n245:             event.pairs.forEach(pair => {\r\n246:                 const bodyA = pair.bodyA;\r\n247:                 const bodyB = pair.bodyB;\r\n248:                 \r\n249:                 // ײ\r\n250:                 const impactForce = this.calculateImpactForce(bodyA, bodyB);\r\n251:                 \r\n252:                 // עײص\r\n253:                 this.collisionCallbacks.forEach(callback => {\r\n254:                     callback(bodyA, bodyB, impactForce);\r\n255:                 });\r\n256:             });\r\n257:         });\r\n258:     }\r\n259:     \r\n260:     /**\r\n261:      * ȡ\r\n262:      * @returns {Array} \r\n263:      */\r\n264:     getAllBodies() {\r\n265:         return this.engine.world.bodies;\r\n266:     }\r\n267:     \r\n268:     /**\r\n269:      * Ƿ嶼ֹ\r\n270:      * @param {number} threshold - ٶֵ\r\n271:      * @returns {boolean} Ƿȫֹ\r\n272:      */\r\n273:     isAllSleeping(threshold = 0.5) {\r\n274:         return this.getAllBodies().every(\r\n275:             body => body.isStatic || body.speed < threshold\r\n276:         );\r\n277:     }\r\n278:     \r\n279:     /**\r\n280:      * \r\n281:      */\r\n282:     cleanup() {\r\n283:         // Ƴײص\r\n284:         this.collisionCallbacks = [];\r\n285:         \r\n286:         // Ƴ壨˾̬棩\r\n287:         const bodies = this.getAllBodies();\r\n288:         bodies.forEach(body => {\r\n289:             if (!body.isStatic || body.label !== 'ground') {\r\n290:                 this.destroyBody(body);\r\n291:             }\r\n292:         });\r\n293:         \r\n294:         \r\n295:     }\r\n296: }\r\n297: \r\n", "stderr": "", "returncode": 0}