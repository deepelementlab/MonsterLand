import { SCENE_KEYS, COLORS } from '../utils/constants.js';

export class MenuScene extends Phaser.Scene {
    constructor() {
        super({ key: SCENE_KEYS.MENU });
    }

    create() {
        const width = this.cameras.main.width;
        const height = this.cameras.main.height;
        
        // 背景
        this.createBackground();
        
        // 游戏标题
        const title = this.add.text(width / 2, 150, '愤怒的小鸟', {
            fontSize: '64px',
            fontFamily: 'Arial Black',
            color: '#FF0000',
            stroke: '#000000',
            strokeThickness: 8
        }).setOrigin(0.5);
        
        // 添加标题动画
        this.tweens.add({
            targets: title,
            y: 140,
            duration: 1000,
            yoyo: true,
            repeat: -1,
            ease: 'Sine.easeInOut'
        });
        
        // 开始游戏按钮
        this.createButton(width / 2, 320, '开始游戏', () => {
            this.scene.start(SCENE_KEYS.GAME, { level: 1 });
        });
        
        // 小鸟装饰
        this.createBirdDecorations();
    }
    
    createBackground() {
        const width = this.cameras.main.width;
        const height = this.cameras.main.height;
        
        // 天空渐变
        const sky = this.add.graphics();
        sky.fillGradientStyle(COLORS.SKY_TOP, COLORS.SKY_TOP, COLORS.SKY_BOTTOM, COLORS.SKY_BOTTOM, 1);
        sky.fillRect(0, 0, width, height);
        
        // 云朵
        for (let i = 0; i < 5; i++) {
            const x = Phaser.Math.Between(100, width - 100);
            const y = Phaser.Math.Between(50, 200);
            this.createCloud(x, y);
        }
        
        // 地面
        const ground = this.add.graphics();
        ground.fillStyle(COLORS.GROUND, 1);
        ground.fillRect(0, height - 80, width, 80);
        
        // 草地装饰
        ground.fillStyle(COLORS.GRASS, 1);
        ground.fillRect(0, height - 80, width, 20);
    }
    
    createCloud(x, y) {
        const cloud = this.add.graphics();
        cloud.fillStyle(0xFFFFFF, 0.9);
        cloud.fillCircle(0, 0, 30);
        cloud.fillCircle(25, 0, 40);
        cloud.fillCircle(50, 0, 30);
        cloud.fillCircle(25, -20, 25);
        cloud.setPosition(x, y);
        
        // 云朵移动动画
        this.tweens.add({
            targets: cloud,
            x: x + 50,
            duration: Phaser.Math.Between(3000, 6000),
            yoyo: true,
            repeat: -1,
            ease: 'Sine.easeInOut'
        });
    }
    
    createButton(x, y, text, callback) {
        const button = this.add.container(x, y);
        
        // 按钮背景
        const bg = this.add.graphics();
        bg.fillStyle(COLORS.UI_PRIMARY, 1);
        bg.fillRoundedRect(-100, -30, 200, 60, 30);
        
        // 按钮文字
        const label = this.add.text(0, 0, text, {
            fontSize: '28px',
            fontFamily: 'Arial',
            color: '#FFFFFF'
        }).setOrigin(0.5);
        
        button.add([bg, label]);
        button.setSize(200, 60);
        button.setInteractive({ useHandCursor: true });
        
        // 悬停效果
        button.on('pointerover', () => {
            this.tweens.add({
                targets: button,
                scaleX: 1.05,
                scaleY: 1.05,
                duration: 100
            });
        });
        
        button.on('pointerout', () => {
            this.tweens.add({
                targets: button,
                scaleX: 1,
                scaleY: 1,
                duration: 100
            });
        });
        
        button.on('pointerdown', callback);
        
        return button;
    }
    
    createBirdDecorations() {
        const width = this.cameras.main.width;
        const height = this.cameras.main.height;
        
        // 创建几只小鸟装饰
        const birdColors = [COLORS.BIRD_RED, COLORS.BIRD_YELLOW, COLORS.BIRD_BLUE];
        
        for (let i = 0; i < 3; i++) {
            const bird = this.add.graphics();
            bird.fillStyle(birdColors[i], 1);
            bird.fillCircle(0, 0, 25);
            
            // 眼睛
            bird.fillStyle(0xFFFFFF, 1);
            bird.fillCircle(-8, -5, 8);
            bird.fillCircle(8, -5, 8);
            bird.fillStyle(0x000000, 1);
            bird.fillCircle(-6, -5, 4);
            bird.fillCircle(10, -5, 4);
            
            // 眉毛
            bird.lineStyle(3, 0x000000, 1);
            bird.lineBetween(-15, -15, -2, -12);
            bird.lineBetween(2, -12, 15, -15);
            
            // 嘴巴
            bird.fillStyle(0xFFA500, 1);
            bird.fillTriangle(20, 0, 35, 5, 35, -5);
            
            bird.setPosition(width / 2 - 100 + i * 100, height - 150);
            
            // 弹跳动画
            this.tweens.add({
                targets: bird,
                y: height - 160,
                duration: 500 + i * 200,
                yoyo: true,
                repeat: -1,
                ease: 'Bounce.easeOut'
            });
        }
    }
}

