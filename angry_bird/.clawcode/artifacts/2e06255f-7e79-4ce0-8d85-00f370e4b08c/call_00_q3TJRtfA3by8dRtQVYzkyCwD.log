import { SCENE_KEYS, COLORS } from '../utils/constants.js';
import { LevelsConfig } from '../config/game.config.js';

export class MenuScene extends Phaser.Scene {
    constructor() {
        super({ key: SCENE_KEYS.MENU });
    }

    create() {
        this.createBackground();
        this.createTitle();
        this.createMenuButtons();
        this.createBirdDecorations();
    }

    createBackground() {
        const width = this.cameras.main.width;
        const height = this.cameras.main.height;
        const sky = this.add.graphics();
        sky.fillGradientStyle(COLORS.SKY_TOP, COLORS.SKY_TOP, COLORS.SKY_BOTTOM, COLORS.SKY_BOTTOM, 1);
        sky.fillRect(0, 0, width, height);
        for (let i = 0; i < 5; i++) {
            this.createCloud(Phaser.Math.Between(100, width - 100), Phaser.Math.Between(50, 200));
        }
        const ground = this.add.graphics();
        ground.fillStyle(COLORS.GRASS, 1);
        ground.fillRect(0, height - 80, width, 20);
        ground.fillStyle(COLORS.GROUND, 1);
        ground.fillRect(0, height - 60, width, 60);
    }

    createCloud(x, y) {
        const cloud = this.add.graphics();
        cloud.fillStyle(0xFFFFFF, 0.9);
        cloud.fillCircle(0, 0, 30);
        cloud.fillCircle(25, 0, 40);
        cloud.fillCircle(50, 0, 30);
        cloud.fillCircle(25, -20, 25);
        cloud.setPosition(x, y);
        this.tweens.add({
            targets: cloud, x: x + 50,
            duration: Phaser.Math.Between(3000, 6000),
            yoyo: true, repeat: -1, ease: 'Sine.easeInOut'
        });
    }

    createTitle() {
        const width = this.cameras.main.width;
        this.titleText = this.add.text(width / 2, 130, '\u6124\u6012\u7684\u5c0f\u9e1f', {
            fontSize: '64px', fontFamily: 'Arial Black',
            color: '#FF0000', stroke: '#5D0000', strokeThickness: 8
        }).setOrigin(0.5);
        this.tweens.add({
            targets: this.titleText, y: 120,
            duration: 1000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut'
        });
        this.add.text(width / 2, 190, 'Angry Birds', {
            fontSize: '24px', fontFamily: 'Arial',
            color: '#FFFFFF', stroke: '#333333', strokeThickness: 3
        }).setOrigin(0.5);
    }

    createMenuButtons() {
        const width = this.cameras.main.width;
        this.menuContainer = this.add.container(0, 0);
        this.menuContainer.add(this.createButton(width / 2, 280, '\ud83c\udfae \u5f00\u59cb\u6e38\u620f', '#4CAF50', () => {
            this.scene.start(SCENE_KEYS.GAME, { level: 1 });
        }));
        this.menuContainer.add(this.createButton(width / 2, 350, '\ud83d\udccb \u5173\u5361\u9009\u62e9', '#2196F3', () => {
            this.showLevelSelectPanel();
        }));
        this.menuContainer.add(this.createButton(width / 2, 420, '\ud83d\udcd6 \u64cd\u4f5c\u8bf4\u660e', '#FF9800', () => {
            this.showHelpPanel();
        }));
    }

    createButton(x, y, text, bgColor, callback) {
        const btn = this.add.text(x, y, text, {
            fontSize: '26px', fontFamily: 'Arial', color: '#FFFFFF',
            backgroundColor: bgColor, padding: { x: 25, y: 10 }
        }).setOrigin(0.5).setInteractive({ useHandCursor: true });
        btn.on('pointerover', () => btn.setScale(1.08));
        btn.on('pointerout', () => btn.setScale(1));
        btn.on('pointerdown', callback);
        return btn;
    }

    _parseProgress(progress) {
        let unlocked = 1;
        for (let i = 1; i <= LevelsConfig.length; i++) {
            if (progress[i] !== undefined) unlocked = i + 1;
        }
        if (unlocked > LevelsConfig.length) unlocked = LevelsConfig.length;
        return unlocked;
    }

    showLevelSelectPanel() {
        if (this.levelPanel) return;
        const width = this.cameras.main.width;
        const height = this.cameras.main.height;