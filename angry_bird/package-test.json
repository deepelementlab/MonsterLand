{
  "name": "angry-bird-game",
  "version": "1.0.0",
  "description": "愤怒的小鸟 - HTML5物理弹射游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=\"tests/unit\"",
    "test:integration": "jest --config jest.config.js --testPathPattern=\"tests/integration\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:performance": "node tests/performance/runner.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix"
  },
  "dependencies": {
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-puppeteer": "^9.0.0",
    "jest-html-reporter": "^3.10.2",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "lighthouse": "^11.4.0",
    "eslint": "^8.55.0",
    "canvas": "^2.11.2",
    "jest-canvas-mock": "^2.5.0"
  }
}