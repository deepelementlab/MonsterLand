## 4. 核心算法设计

### 4.1 游戏主循环

```javascript
class Game {
    constructor() {
        this.canvas = document.getElementById('gameCanvas');
        this.ctx = this.canvas.getContext('2d');
        this.lastTime = 0;
        
        // 初始化各模块
        this.input = new InputHandler();
        this.track = new Track(this.canvas.width, this.canvas.height);
        this.player = new PlayerCar(this.canvas.width / 2 - 20, this.canvas.height - 120);
        this.enemies = [];
        this.gameManager = new GameManager();
        this.difficulty = new DifficultyManager();
        this.renderer = new RenderSystem(this.ctx);
        
        this.track.init();
    }
    
    // 主循环
    gameLoop(currentTime) {
        const deltaTime = (currentTime - this.lastTime) / 1000;
        this.lastTime = currentTime;
        
        // 限制deltaTime防止卡顿后的大跳跃
        const clampedDelta = Math.min(deltaTime, 0.1);
        
        // 处理输入
        this.handleInput();
        
        // 根据游戏状态更新
        switch(this.gameManager.state) {
            case GameState.PLAYING:
                this.update(clampedDelta);
                this.checkCollisions();
                break;
        }
        
        // 渲染
        this.renderer.render(this);
        
        requestAnimationFrame((t) => this.gameLoop(t));
    }
    
    update(deltaTime) {
        const gameSpeed = this.player.speed;
        
        // 更新游戏状态
        this.gameManager.update(deltaTime, gameSpeed);
        
        // 更新赛道
        this.track.update(deltaTime, gameSpeed);
        
        // 更新玩家
        this.player.update(deltaTime);
        
        // 更新敌车
        for (let enemy of this.enemies) {
            enemy.update(deltaTime, gameSpeed);
        }
        
        // 清理离开屏幕的敌车
        this.enemies = this.enemies.filter(e => !e.isOffScreen(this.canvas.height));
        
        // 生成新敌车
        this.difficulty.update(deltaTime, this.gameManager.level);
        if (this.difficulty.shouldSpawn()) {
            this.spawnEnemy();
        }
    }
}
```

### 4.2 碰撞检测算法

```javascript
class CollisionSystem {
    // AABB碰撞检测
    static checkAABB(rect1, rect2) {
        return rect1.intersects(rect2);
    }
    
    // 带缩小的碰撞检测（更宽容的碰撞判定）
    static checkForgivingAABB(entity1, entity2, shrinkFactor = 0.8) {
        const b1 = entity1.getBounds();
        const b2 = entity2.getBounds();
        
        // 缩小碰撞框
        const shrink1 = (1 - shrinkFactor) / 2;
        const shrink2 = (1 - shrinkFactor) / 2;
        
        const forgiving1 = new Rectangle(
            b1.x + b1.width * shrink1,
            b1.y + b1.height * shrink1,
            b1.width * shrinkFactor,
            b1.height * shrinkFactor
        );
        
        const forgiving2 = new Rectangle(
            b2.x + b2.width * shrink2,
            b2.y + b2.height * shrink2,
            b2.width * shrinkFactor,
            b2.height * shrinkFactor
        );
        
        return forgiving1.intersects(forgiving2);
    }
    
    // 批量碰撞检测
    static checkPlayerEnemies(player, enemies) {
        const collisions = [];
        
        for (let enemy of enemies) {
            if (this.checkForgivingAABB(player, enemy, 0.75)) {
                collisions.push(enemy);
            }
        }
        
        return collisions;
