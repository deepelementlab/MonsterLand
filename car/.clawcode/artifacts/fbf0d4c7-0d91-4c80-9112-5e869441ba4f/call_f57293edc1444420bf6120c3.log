### 3.5 游戏状态管理

```javascript
const GameState = {
    MENU: 'menu',
    PLAYING: 'playing',
    PAUSED: 'paused',
    GAME_OVER: 'game_over'
};

class GameManager {
    constructor() {
        this.state = GameState.MENU;
        this.score = 0;
        this.highScore = this.loadHighScore();
        this.distance = 0;
        this.level = 1;
        this.combo = 0;
        this.comboTimer = 0;
    }
    
    startGame() {
        this.state = GameState.PLAYING;
        this.score = 0;
        this.distance = 0;
        this.level = 1;
        this.combo = 0;
    }
    
    addScore(points) {
        this.score += points * (1 + this.combo * 0.1);
        this.combo++;
        this.comboTimer = 3.0;
    }
    
    update(deltaTime, speed) {
        if (this.state === GameState.PLAYING) {
            // 距离增加
            this.distance += speed * deltaTime;
            
            // 分数随距离增加
            this.score += Math.floor(speed * deltaTime * 0.1);
            
            // 难度递进
            this.level = Math.floor(this.distance / 1000) + 1;
            
            // 连击计时
            if (this.comboTimer > 0) {
                this.comboTimer -= deltaTime;
                if (this.comboTimer <= 0) {
                    this.combo = 0;
                }
            }
        }
    }
    
    gameOver() {
        this.state = GameState.GAME_OVER;
        if (this.score > this.highScore) {
            this.highScore = this.score;
            this.saveHighScore();
        }
    }
    
    loadHighScore() {
        return parseInt(localStorage.getItem('raceHighScore') || '0');
    }
    
    saveHighScore() {
        localStorage.setItem('raceHighScore', this.highScore.toString());
    }
}
```

