  "layer_descriptions": {
    "Entry Point": "HTML5 page (index.html) that loads assets, initializes Canvas, and bootstraps the game application",
    "Presentation": "CSS styles (styles.css) handling game container layout, HUD positioning, responsive sizing, and visual theming",
    "Game Engine": "Core engine in game.js managing the main game loop, Canvas rendering pipeline, gravity simulation, and AABB collision detection",
    "Game Entities": "OOP classes for Player (movement, attack, invincibility), Monster subclasses with distinct AI behaviors (patrol, chase, jump), and collectible items (coins, keys)",
    "Level System": "Level data and configuration defining platform layouts, monster spawns, item placement, and theme-specific styling for forest, cave, and sky stages",
    "Effects & Audio": "Particle system for visual feedback (kills, pickups) and Web Audio API for synthesized sound effects without external audio files",
    "UI Screens": "State-driven screen management for main menu, pause overlay, level completion, game over, and HUD displaying health, score, and key status",
    "Documentation": "Project documentation including README.md with game instructions and the docs/ directory for additional references"
