// ==================== 游戏配置 ====================
const CONFIG = {
    CANVAS_WIDTH: 900,
    CANVAS_HEIGHT: 600,
    GRAVITY: 0.6,
    PLAYER_SPEED: 5,
    JUMP_FORCE: -14,
    TILE_SIZE: 40
};

// ==================== 游戏状态 ====================
const GameState = {
    MENU: 'menu',
    PLAYING: 'playing',
    PAUSED: 'paused',
    LEVEL_COMPLETE: 'level_complete',
    GAME_OVER: 'game_over',
    VICTORY: 'victory'
};

// ==================== 关卡数据 ====================
const LEVELS = [
    // 关卡 1 - 入门
    {
        name: "绿野森林",
        platforms: [
            {x: 0, y: 560, w: 900, h: 40},
