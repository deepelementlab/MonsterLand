* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

#game-container {
    width: 100%;
    max-width: 900px;
    height: 100vh;
    max-height: 600px;
    position: relative;
    background: #0f0f23;
    border-radius: 10px;
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
    overflow: hidden;
}

.screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease;
}

.hidden {
    display: none !important;
}

.overlay {
    background: rgba(0, 0, 0, 0.85);
    z-index: 100;
}

/* Start Screen */
#start-screen {
    background: linear-gradient(180deg, #1a1a2e 0%, #0f3460 100%);
}

.title-container {
    text-align: center;
    margin-bottom: 40px;
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

.game-title {
    font-size: 3em;
    color: #00fff5;
    text-shadow: 0 0 20px #00fff5, 0 0 40px #00fff5;
    margin-bottom: 10px;
}

.subtitle {
    font-size: 1.5em;
    color: #e94560;
    text-shadow: 0 0 10px #e94560;
}

.menu-buttons {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.btn {
    padding: 15px 40px;
    font-size: 1.2em;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: bold;
}

.btn-primary {
    background: linear-gradient(135deg, #e94560 0%, #ff6b6b 100%);
    color: white;
    box-shadow: 0 5px 15px rgba(233, 69, 96, 0.4);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(233, 69, 96, 0.6);
}

.btn-secondary {
    background: linear-gradient(135deg, #0f3460 0%, #16213e 100%);
    color: #00fff5;
    border: 2px solid #00fff5;
}

.btn-secondary:hover {
    background: #00fff5;
    color: #16213e;
}

.instructions {
    margin-top: 30px;
    background: rgba(15, 52, 96, 0.8);
    padding: 20px;
    border-radius: 10px;
    border: 2px solid #00fff5;
    max-width: 400px;
    text-align: left;
}

.instructions h3 {
    color: #00fff5;
    margin-bottom: 10px;
    margin-top: 15px;
}

.instructions h3:first-child {
    margin-top: 0;
}

.control-item, .goal-item {
    color: #fff;
    padding: 5px 0;
    font-size: 0.95em;
}

/* Game Screen */
#game-screen {
    background: #1a1a2e;
}

#game-hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-around;
    padding: 10px;
    background: rgba(0, 0, 0, 0.7);
    z-index: 10;
}

.hud-item {
    display: flex;
    align-items: center;
    gap: 8px;
}

.hud-label {
    color: #00fff5;
    font-size: 1em;
}

.hud-value {
    color: #fff;
    font-size: 1.2em;
    font-weight: bold;
}

#game-canvas {
    width: 100%;
    height: 100%;
    display: block;
}

.btn-pause {
    position: absolute;
    top: 50px;
    right: 10px;
    width: 50px;
    height: 50px;
    font-size: 1.5em;
    background: rgba(0, 0, 0, 0.5);
    border: 2px solid #00fff5;
    border-radius: 50%;
    color: #00fff5;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
}

.btn-pause:hover {
    background: #00fff5;
    color: #1a1a2e;
}

/* Pause & Game Over Screens */
.pause-menu, .complete-menu, .gameover-menu {
    background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
    padding: 40px;
    border-radius: 15px;
    border: 3px solid #00fff5;
    text-align: center;
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
}

.pause-menu h2, .complete-menu h2, .gameover-menu h2 {
    color: #00fff5;
    margin-bottom: 30px;
    font-size: 2em;
    text-shadow: 0 0 10px #00fff5;
}

.stats {
    margin: 20px 0;
}

.stats p {
    color: #fff;
    font-size: 1.2em;
    margin: 10px 0;
}

.stats span {
    color: #ffd700;
    font-weight: bold;
}

/* Responsive */
@media (max-width: 600px) {
    .game-title {
        font-size: 2em;
    }
    
    .subtitle {
        font-size: 1em;
    }
    
    .btn {
        padding: 12px 30px;
        font-size: 1em;
    }
    
    .instructions {
        margin: 20px;
        padding: 15px;
    }
}

